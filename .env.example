# Copy to .env only if you do not use operating-system environment variables.
# Never put a real key in this example or commit your .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra
OPENROUTER_REVIEW_MODEL=openai/gpt-6-astra
OPENROUTER_MODEL_OPTIONS={"openai/gpt-6-astra":{"reasoning_effort":"high","max_output_tokens":8000,"provider_ignore":["openai/flex"]}}
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
PROVIDER_TIMEOUT_SECONDS=120
OPERATION_TIMEOUT_SECONDS=360
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.com
DAILY_EVALUATION=true
# Daily evaluation runs all 45 questions and uses live credits; false disables it.
# Exact hostnames only; default local access. No wildcard public exposure.
# ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
